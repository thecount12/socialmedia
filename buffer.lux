/*
quick lux script to post to linkedin, instagram and mastadon
*/
import "creds.lux";

var channel = [
 "6ab88c84ea19ca0bdefe5a07",
 "6ab887a2ea19ca0bdefe21c7",
 "6ab87246ea19ca0bdefd7b57"];


class Headers { init() {}}
class GraphQLRequest { init(query) {this.query = query;} }


fun draftPost(channel, text, image_url) {
	var cleanId = strTrim(channel);
	var media_metadata = ""; // instagram
	if (cleanId == "6ab87246ea19ca0bdefd7b57") {
		media_metadata = "    metadata: { instagram: { type: post, shouldShareToFeed: true } }\n";
	}

	var query = "
mutation CreateDraftPost {
  createPost(input: {
    text: \"\"\"" + text +  "\"\"\"
    channelId: \"" + channel + "\"
    schedulingType: automatic
    mode: addToQueue
    saveToDraft: true
" + media_metadata + "
    assets: [
      {
        image: {
          url: \"" + image_url + "\"
        }
      }
    ]
  }) {
    ... on PostActionSuccess {
      post {
        id
        text
      }
    }
    ... on MutationError {
      message
    }
  }
}
	";
	return query;
}

var msg = "Deploying cross-platform micro-updates directly via lux9.dev #buildinpublic";

// lets post some code to social media
var function_source_code = "
Here is the source code to publish to linkedin, instagram, mastadon using lux9.dev
fun BufferAPI(query) {
    var access_key = appSecret();
    var headers = Headers();
    headers.authorization = \"Bearer access_key\";
    headers.Content_Type = \"application/json\";
    var url = \"https://api.buffer.com\";
    var body = toJSON(GraphQLRequest(query));
    var res = httpRequest(\"POST\", url, body, headers);
    return res;
}
";


fun BufferAPI(query) {
	var access_key = appSecret();
	var headers = Headers();
	headers.authorization = "Bearer " + access_key;
	headers.Content_Type = "application/json";
	var url = "https://api.buffer.com";
	var body = toJSON(GraphQLRequest(query));
	var res = httpRequest("POST", url, body, headers);
	return res;
}


